# Discord bot token - https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API key - https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Bot Owner Discord User ID (for owner-only commands like !restart, !update, !shutdown)
# Right-click yourself in Discord > Copy ID (requires Developer Mode)
BOT_OWNER_ID=your_discord_user_id_here

# Optional: Discord Forum Channel ID for campaigns
# If set, !startcampaign creates a forum post instead of a thread
# Right-click forum channel > Copy ID (requires Developer Mode)
CAMPAIGN_FORUM_ID=

# Optional: Claude model to use (default: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: Command prefix (default: !)
COMMAND_PREFIX=!
